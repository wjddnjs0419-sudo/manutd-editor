{
  "name": "Instagram Collector Schedule",
  "nodes": [
    {
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "position": [0, 0]
    },
    {
      "name": "Collect Active Instagram Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://byymtttpwmllqvggnddm.supabase.co/functions/v1/collect-instagram",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Instagram Collector Invoke Secret"
        }
      },
      "position": [260, 0]
    },
    {
      "name": "Run Content Intelligence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://byymtttpwmllqvggnddm.supabase.co/functions/v1/intelligence",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "options": {
          "response": {
            "response": {
              "includeResponseHeadersAndStatus": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Instagram Collector Invoke Secret"
        }
      },
      "position": [520, 0]
    },
    {
      "name": "Sync Daily Intelligence to Notion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "parameters": {
        "method": "POST",
        "url": "https://byymtttpwmllqvggnddm.supabase.co/functions/v1/sync-notion-intelligence",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": false,
        "options": {
          "response": {
            "response": {
              "includeResponseHeadersAndStatus": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Instagram Collector Invoke Secret"
        }
      },
      "position": [780, 0]
    }
  ],
  "connections": {
    "Every 30 Minutes": {
      "main": [
        [
          {
            "node": "Collect Active Instagram Accounts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Active Instagram Accounts": {
      "main": [
        [
          {
            "node": "Run Content Intelligence",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Content Intelligence": {
      "main": [
        [
          {
            "node": "Sync Daily Intelligence to Notion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Seoul",
    "executionOrder": "v1"
  },
  "active": false
}
